# ===== LLM 模型（任意 OpenAI 兼容接口，公有云或内网私有化模型）=====
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=gpt-4o-mini
# 视觉（多模态图片输入）模型；为空时回退使用 LLM_MODEL
# LLM_VISION_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-ada-002
# embedding 后端：remote（走 OpenAI 兼容接口，默认）/ local（离线 n-gram 兜底，无外部依赖）
# EMBED_BACKEND=remote

# ===== LLM 调用健壮性 =====
# 单次调用超时（秒）
# LLM_TIMEOUT=60
# 失败自动重试次数
# LLM_MAX_RETRIES=2

# ===== 数据与知识库（默认相对项目根目录，可不填）=====
# DB_URL=sqlite:///data/inspection.db
# MySQL 连接参数（DB_URL 以 mysql:// 开头时使用）
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=glass_inspection
# MYSQL_CHARSET=utf8mb4
# KB_DIR=data/docs
# VECTOR_STORE_PATH=data/vector_store.json

# ===== 检索（RAG）=====
# 粗召回片段数（默认 12：容纳复合问题所需多个来源块）
# RETRIEVE_TOP_K=12
# Rerank 召回候选数（先粗召回候选，再由 reranker 精排）
# RERANK_CANDIDATES=30
# Rerank 精排后保留片段数
# RERANK_TOP_K=6
# 查询改写：true 开启（默认，含同义词扩展）/ false 关闭
# QUERY_REWRITE=true

# ===== 诊断流开关 =====
# 开启后 router 可路由到 diagnosis（根因诊断）流
# DIAGNOSIS_ENABLED=true

# ===== 结构化日志 =====
# DEBUG / INFO / WARNING / ERROR
# LOG_LEVEL=INFO

# ===== 知识库未收录主题时的回答策略 =====
# true（默认）= 回退用 LLM 通用知识回答，但标注“非部门标准口径”；
# false = 严格拒答，仅说明知识库未收录并建议补充文档
# QA_FALLBACK=true
